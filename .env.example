# =====================================================================
#  Ma Cave Virtuelle - variables d'environnement
# =====================================================================
# Copiez ce fichier en `.env.local` pour le developpement local,
# et renseignez les memes variables dans Vercel pour la production.
#
# L'application fonctionne SANS aucune de ces variables : elle demarre
# alors en "mode demo" (donnees stockees dans votre navigateur, pas d'IA).
# Renseignez-les pour activer la persistance Supabase et les fonctions IA.
# ---------------------------------------------------------------------

# --- Supabase (base de donnees + authentification + stockage photos) ---
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Claude API (accords, reconnaissance d'etiquette, fenetre de garde, LPV) ---
# https://console.anthropic.com/  > API Keys
# Cette cle reste cote serveur, jamais exposee au navigateur.
ANTHROPIC_API_KEY=

# Modele utilise pour les appels IA. Par defaut : claude-opus-4-8 (le plus capable).
# Pour reduire les couts, vous pouvez choisir un modele moins cher, par ex :
#   claude-sonnet-4-6   (bon compromis)
#   claude-haiku-4-5    (le moins cher)
ANTHROPIC_MODEL=claude-opus-4-8
